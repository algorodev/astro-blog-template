---
import type { CollectionEntry } from 'astro:content'
import FormattedDate from '@/components/FormattedDate.astro'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
---

<li class="group">
  <a href={`/blog/${post.slug}/`} class="block rounded-lg p-4 transition hover:bg-neutral-50">
    <h2 class="text-lg font-semibold text-neutral-900 group-hover:text-neutral-600">
      {post.data.title}
    </h2>
    <FormattedDate date={post.data.pubDate} class="mt-1 text-sm text-neutral-500" />
    <p class="mt-2 text-sm text-neutral-600 line-clamp-2">{post.data.description}</p>
    {post.data.tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-2">
        {post.data.tags.map((tag) => (
          <li>
            <span class="rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-700">
              {tag}
            </span>
          </li>
        ))}
      </ul>
    )}
  </a>
</li>
