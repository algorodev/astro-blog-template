---
import { getCollection, getEntry } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import FormattedDate from '@/components/FormattedDate.astro'

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft)
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content, headings } = await post.render()
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="prose prose-neutral mx-auto max-w-2xl px-4 py-12">
    <header class="mb-8 not-prose">
      <h1 class="text-3xl font-bold tracking-tight">{post.data.title}</h1>
      <FormattedDate date={post.data.pubDate} class="mt-2 text-sm text-neutral-500" />
      {post.data.tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <li>
              <a
                href={`/blog/tags/${tag}`}
                class="rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-700 hover:bg-neutral-200"
              >
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )}
    </header>
    <Content />
  </article>
</BaseLayout>
